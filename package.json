{
  "name": "zentoner",
  "version": "1.0.0",
  "description": "Una aplicación para gestionar y organizar el negocio de impresión laser.",
  "author": "Gerson Jean Pierre",
  "main": "electron/main.js",
  "build": {
    "appId": "app.zentoner",
    "productName": "ZenToner",
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "files": [
      "dist/zentoner/**/*",
      "electron/main.js",
      "electron/preload.js",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration production",
    "test": "ng test",
    "deploy:cf": "node generate-env.js && npm run build",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.13",
    "@angular/compiler": "^20.3.13",
    "@angular/core": "^20.3.13",
    "@angular/forms": "^20.3.13",
    "@angular/platform-browser": "^20.3.13",
    "@angular/router": "^20.3.13",
    "@angular/service-worker": "^20.3.13",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@sqlite.org/sqlite-wasm": "^3.51.0-build1",
    "@supabase/supabase-js": "^2.84.0",
    "@tailwindcss/postcss": "^4.1.17",
    "camelcase-keys": "^10.0.1",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.2",
    "snakecase-keys": "^9.0.2",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.6.0",
    "@angular/build": "^20.3.11",
    "@angular/cli": "^20.3.11",
    "@angular/compiler-cli": "^20.3.13",
    "@eslint/js": "^9.39.1",
    "@iconify/json": "^2.2.409",
    "@iconify/tailwind4": "^1.1.0",
    "@types/humps": "^2.0.6",
    "@types/jasmine": "~5.1.13",
    "angular-eslint": "20.6.0",
    "daisyui": "^5.5.5",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.3"
  }
}