{
  "name": "zentoner",
  "version": "1.0.0",
  "description": "Una aplicación para gestionar y organizar el negocio de impresión laser.",
  "author": "Gerson Jean Pierre",
  "main": "electron/main.js",
  "build": {
    "appId": "app.zentoner",
    "productName": "ZenToner",
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "files": [
      "dist/zentoner/**/*",
      "electron/main.js",
      "electron/preload.js",
      "node_modules/**/*",
      "!node_modules/@tailwindcss/oxide-*",
      "!node_modules/@emnapi/**"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration production",
    "test": "ng test",
    "electron": "ng build --base-href ./ && electron .",
    "package": "ng build --base-href ./ && electron-builder",
    "deploy:cf": "node generate-env.js && npm run build",
    "build:electron:win": "node set-supabase-env.js && ng build --base-href ./ --configuration production && electron-builder"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.6",
    "@angular/compiler": "^20.3.6",
    "@angular/core": "^20.3.6",
    "@angular/forms": "^20.3.6",
    "@angular/platform-browser": "^20.3.6",
    "@angular/router": "^20.3.6",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@supabase/supabase-js": "^2.76.1",
    "@tailwindcss/postcss": "^4.1.15",
    "camelcase-keys": "^10.0.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.2",
    "snakecase-keys": "^9.0.2",
    "tailwindcss": "^4.1.15",
    "tslib": "^2.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.6",
    "@angular/cli": "^20.3.6",
    "@angular/compiler-cli": "^20.3.6",
    "@iconify/json": "^2.2.398",
    "@iconify/tailwind4": "^1.0.6",
    "@types/humps": "^2.0.6",
    "@types/jasmine": "~5.1.12",
    "daisyui": "^5.3.7",
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3"
  }
}